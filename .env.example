# Database Connection String (PostgreSQL / Supabase)
POSTGRES_CONNECTION_STRING=Host=aws-0-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-ref;Password=your-password;SSL Mode=Require;Trust Server Certificate=true;

# ImgBB API Key for automatic image uploads
# Obtain your free API key at: https://api.imgbb.com
IMGBB_API_KEY=

# Google OAuth 2.0 Web Client ID
# Obtain at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# JWT Secret Key
JWT_SECRET_KEY=your_jwt_secret_key_here
